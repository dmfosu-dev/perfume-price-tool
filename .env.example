# Copy to .env and fill in. Never commit the real file — .env is gitignored.

# --- Database (Supabase Postgres) -------------------------------------------
# App connection. Use the *Transaction pooler* string (port 6543): serverless
# functions open many short-lived connections and would exhaust a direct pool.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations only. The *Direct connection* string (port 5432) — pgbouncer in
# transaction mode cannot run the DDL and advisory locks Prisma Migrate needs.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (product photos) --------------------------------------
# Without these the app falls back to writing into /public/uploads, which is
# fine locally but does not survive on Vercel.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-only, never exposed
SUPABASE_STORAGE_BUCKET="product-photos"

# --- First admin (used once, by `npm run db:seed`) --------------------------
ADMIN_EMAIL="you@example.com"
# If unset the seed generates a password and prints it once.
# ADMIN_PASSWORD=""

# --- FX providers -----------------------------------------------------------
EXCHANGERATE_API_KEY=""
WISE_API_TOKEN=""

# --- Keep-alive -------------------------------------------------------------
# Any long random string. Vercel Cron is recognised automatically; this guards
# the endpoint against everyone else.
CRON_SECRET=""
